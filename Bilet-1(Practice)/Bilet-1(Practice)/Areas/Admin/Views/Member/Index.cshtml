@using Bilet_1_Practice_.Models
@model List<Member>
<div>
	<a class="btn btn-primary" asp-controller="Member" asp-action="Create">Add Member</a>

	<table class="table table-bordered">
		<thead>
			<tr>
				<th scope="col">#</th>
				<th scope="col">Name</th>
				<th scope="col">Surname</th>
				<th scope="col">Position</th>
				<th scope="col">Image</th>
				<th scope="col">Is Deleted</th>
				<th colspan="3" scope="col">Action</th>

			</tr>
		</thead>
		<tbody>
			@foreach (Member member in Model)
			{
				<tr>
					<th scope="row">@member.Id</th>
					<td>@member.Name</td>
					<td>@member.Surname</td>
					<td>@member.Position</td>
					<td>
						<img style="width:50px; height:50px;" src="~/uploads/members/@member.ImageUrl" alt="" />
					</td>
					@if (!member.IsDeleted)
					{
						<td class="text-success">Active</td>
					}
					else
					{
						<td class="text-danger">Inactive</td>
					}
					<td>
						<a class="btn btn-primary" asp-controller="Member" asp-action="Update" asp-route-id="@member.Id">Update</a>
					</td>

					@if (!member.IsDeleted)
					{
						<td>
							<form asp-controller="Member" asp-action="SoftDelete" asp-route-id="@member.Id" method="post">
								<button type="submit" class="btn btn-warning">SoftDelete</button>
							</form>
						</td>
					}
					else
					{
						<td>
							<form asp-controller="Member" asp-action="Restore" asp-route-id="@member.Id" method="post">
								<button type="submit" class="btn btn-success">Restore</button>
							</form>
						</td>
					}

					<td>
						<form asp-controller="Member" asp-action="HardDelete" asp-route-id="@member.Id" method="post">
							<button type="submit" class="btn btn-danger">HardDelete</button>
						</form>
					</td>


				</tr>
			}
		</tbody>
	</table>
</div>